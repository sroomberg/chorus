{
  "name": "chorus",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:relay": "cargo build -p chorus-relay --release",
    "test:relay": "cargo test -p chorus-relay",
    "build": "bun run build:relay && turbo run build",
    "test": "bun run build:relay && bun run test:relay && turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "clean": "turbo run clean && cargo clean"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  }
}
